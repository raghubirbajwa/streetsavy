# Required. Explicitly choose fixture, test or live; independent of NODE_ENV.
# fixture disables external integrations and requires no credentials.
# test uses isolated data, Razorpay test keys and fixture shipping.
# live requires HTTPS; missing credentials block the affected feature.
APP_MODE=fixture
APP_URL=http://localhost:3000

# Required at Supabase feature entry outside fixture mode.
# Only a publishable key or legacy anon JWT belongs in the public variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Required at R2 feature entry outside fixture mode.
# Public bucket must differ from staging/private; staging/private may coincide.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STAGING_BUCKET=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=

# Required at payment / payment-webhook feature entry respectively.
# APP_MODE=test needs rzp_test_...; live needs rzp_live_... .
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shipping API is disabled in fixture AND test. No sandbox is assumed.
# Webhook token is separate, required only for an enabled tracking webhook.
# Official logistics docs describe x-api-key, not an HMAC signature.
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=

# Required for an enabled external job runner; at least 32 characters.
JOBS_SECRET=

# Required at notification feature entry; provider still to be selected.
# FROM is a plain email address, not a display-name/address pair.
TRANSACTIONAL_EMAIL_PROVIDER=
TRANSACTIONAL_EMAIL_API_KEY=
TRANSACTIONAL_EMAIL_FROM=
